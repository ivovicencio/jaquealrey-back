# ── Entorno ──
NODE_ENV=development

# ── Puerto (Vercel asigna el suyo, usar fallback local) ──
PORT=3000
CANCELACION_HORAS=24

# Liberacion automatica de reservas sin pagar. Una reserva `Pendiente` que el
# huesped abandona (se distrae, no puede transferir, cambia de idea) bloquea la
# habitacion para siempre, porque `Pendiente` cuenta como ocupada. En temporada
# eso son ventas perdidas.
#   RESERVAS_EXPIRAR_HORAS=48    horas para pagar antes de que se libere sola (0 = no liberar)
#   RESERVAS_EXPIRAR_CADA_MS=900000    cada cuanto corre la limpieza (15 min)
#
# OJO: las reservas cuyo huesped ya aviso "ya transferi" NO se liberan solas.
# El hotel tiene que ver la plata y confirmarlas a mano.
RESERVAS_EXPIRAR_HORAS=48
RESERVAS_EXPIRAR_CADA_MS=900000

# ── Supabase (PostgreSQL) ──
# Usar Transaction Pooler (puerto 6543) para Vercel serverless
#
# La app usa un rol SIN privilegios a proposito: es lo que hace que las
# politicas de RLS valgan de verdad, porque un superusuario las saltea siempre.
DATABASE_URL=postgresql://usuario_app:password@db.xxxxx.supabase.co:5432/postgres

# Solo para las migraciones (npm run db:migrate, o los db:init / db:rls / etc.).
# Necesita CREATE y CREATEROLE, asi que va con el usuario propietario.
# No se usa en runtime: si se, la app queda como superusuario y RLS deja de
# proteger nada.
DATABASE_ADMIN_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Máximo de conexiones del pool. Subirlo de más no ayuda: cada conexión es una de
# las 200 que acepta Postgres, y la base va a ser el cuello de botella antes.
DB_POOL_MAX=20

# ── JWT ──
# Generar con: openssl rand -hex 64
JWT_SECRET=debes_cambiar_esto_en_produccion
JWT_EXPIRES_IN=86400
# Coste de bcrypt. Subirlo suma CPU en cada login; bajarlo debilita los hashes.
BCRYPT_ROUNDS=12

# ── CORS (separar múltiples orígenes con coma) ──
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# ── Proxy (solo si la app corre detrás de uno) ──
# Cuántos saltos de proxy confiar para resolver req.ip. Sin esto, todos los
# clientes comparten un contador de rate limit. 1 = Vercel/nginx (un proxy).
# OJO: nunca "true", el cliente podría falsear su propia IP.
TRUST_PROXY_HOPS=1

# ── Redis (opcional, Upstash para Vercel) ──
REDIS_URL=redis://default:password@xxxxx.upstash.io:6379
CACHE_TTL=60

# ── Admin interno (email que identifica al administrador) ──
ADMIN_EMAIL=admin@jaquealrey.com
# Secret para registrarse como admin (si está vacío, cualquiera con el email admin puede registrarse)
ADMIN_SECRET=tu_admin_secret_aqui
# Teléfono del hotel, se incluye en los avisos que se le mandan al huésped
HOTEL_PHONE=02942664320

# ── WhatsApp Cloud API (opcional, para notificar reservas) ──
# Si queda vacío no se envía ningún WhatsApp, la app sigue funcionando igual.
# ADMIN_WHATSAPP: avisa al hotel (reserva nueva y cancelación del huésped)
# WHATSAPP_TOKEN + WHATSAPP_PHONE_ID: avisa al huésped (confirmación y cancelación del hotel)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
ADMIN_WHATSAPP=

# ── Rate limits (opcionales: si faltan, cada uno usa su default) ──
# Ventana fija de 15 minutos para todos salvo REGISTER y RESERVA_POR_EMAIL,
# que son de 1 hora. Máximo de pedidos por clave en esa ventana.
#
# El límite que importa para el negocio es RESERVA_MAX. Los huéspedes de un
# hotel salen todos por la misma IP pública (la del wifi, por NAT), así que un
# valor bajo bloquea a huéspedes legítimos y el hotel pierde ventas. 60 es
# deliberadamente holgado: el abuso se frena con RESERVA_POR_EMAIL_MAX, que no
# depende de la IP. Bajá este valor solo si tenés un motivo concreto.
GLOBAL_MAX=300
LOGIN_MAX=10
REGISTER_MAX=5
RESERVA_MAX=60
RESERVA_POR_EMAIL_MAX=5
ADMIN_MAX=60
USUARIO_MAX=30

# Nota: no hay pasarela de pago. El hotel cobra por transferencia a alias
# bancario y el admin marca el pago como confirmado desde el panel, asi que no
# hay webhook, ni token de API, ni comision. Si alguna vez se agrega una, las
# variables van aca y se leen desde config/index.js, no desde el codigo.
