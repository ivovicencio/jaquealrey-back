# Normalizacion de fin de linea y espacios. Configuracion comun para que un
# cambio de linea sola no genere un diff gigante entre maquinas.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sql,yml,yaml}]
indent_size = 2